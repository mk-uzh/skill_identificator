{
  "name": "devskill-study",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental web app for the DevSkill case study: manual vs. AI-supported team skill matrix assessment.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
